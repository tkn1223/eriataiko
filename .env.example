# このファイルをコピーして .env.local を作る
#   cp .env.example .env.local
# .env* は .gitignore 済み。コミットしないこと。

# ---------------------------------------------------------------
# Supabase — Dashboard > Project Settings > API から取得
# ---------------------------------------------------------------
# 「Project URL」
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 「anon public」キー（新方式なら sb_publishable_... でも可）
# これはブラウザに配られる = 公開される前提の値。隠す必要はない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 「service_role」キー（新方式なら sb_secret_...）
# RLS を無視できる。絶対に公開しない・NEXT_PUBLIC_ を付けない。
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# 入場（セッション）
# ---------------------------------------------------------------
# Cookie の署名鍵。次のコマンドで生成する:
#   openssl rand -base64 32
SESSION_SECRET=

# 大会共通の合言葉。当日 運営に口頭で伝える 1 個だけ。
# 空にすると合言葉なしで誰でも入場できる（身内の動作確認向け）。
TOURNAMENT_PASSCODE=

# ---------------------------------------------------------------
# 当日バックアップ（Google スプレッドシート）— 手順は docs/backup.md
# 大会当日だけ動く機能。開発中は空のままでよい（空なら API が日本語で
# 「未設定です」と返すだけで、他の機能は普通に動く）。
# ---------------------------------------------------------------
# /api/backup を叩くための秘密。GitHub Actions 側にも同じ値を入れる。
#   openssl rand -base64 32
BACKUP_SECRET=

# サービスアカウントの JSON の client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# サービスアカウントの JSON の private_key（"" は含めない。\n が混ざっていてもよい）
GOOGLE_PRIVATE_KEY=

# 書き出し先スプレッドシートの URL の /d/ と /edit の間の文字列
BACKUP_SPREADSHEET_ID=
